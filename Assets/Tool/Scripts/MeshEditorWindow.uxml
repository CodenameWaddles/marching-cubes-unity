<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Tool/Scripts/MeshEditorWindow.uss?fileID=7433441132597879392&amp;guid=67eb18d5a0c5f804d8ad34d681e73cd6&amp;type=3#MeshEditorWindow"/>
    <ui:VisualElement name="main" style="flex-grow: 1; min-width: 500px;">
        <ui:Label text="Marching cubes mesh editor" name="title" class="custom-label" style="color: rgb(255, 255, 255); font-size: 36px; flex-wrap: wrap;"/>
        <ui:VisualElement name="mesh_settings" style="flex-grow: 1; flex-direction: row; border-top-width: 10px; border-bottom-width: 10px; border-left-width: 4px; flex-wrap: wrap;">
            <ui:Button text="Generate mesh" name="generate" style="border-left-width: 1px; border-right-width: 1px; max-height: 80px; align-self: center; min-height: 50px;"/>
            <ui:Vector3IntField label="Field Size" name="field_size" value="30,30,30" style="flex-direction: column; border-left-width: 5px; border-right-width: 5px; max-height: 40px; align-items: stretch; align-self: center; justify-content: flex-start;"/>
            <ui:VisualElement style="flex-grow: 1; border-left-width: 5px; border-right-width: 5px;">
                <ui:DropdownField label="Density function type" choices="Flat,Noise,Sphere" enabled="true" name="density_type" style="max-width: 300px; flex-direction: column;"/>
                <ui:Slider label="Surface level" value="-20" high-value="20" name="surface_level" fill="false" direction="Horizontal" style="max-width: 300px; border-top-width: 5px; border-bottom-width: 5px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="preview_container" style="flex-grow: 1; flex-direction: row; min-height: 400px; max-width: 800px; border-top-width: 10px; border-bottom-width: 10px; border-top-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 5px;">
            <ui:VisualElement name="editor_settings" style="flex-grow: 1; flex-direction: column; flex-wrap: wrap; height: auto; background-color: rgb(75, 75, 75); width: 30%; max-width: 30%;">
                <ui:VisualElement name="settings" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap;">
                    <ui:VisualElement name="sliders" style="flex-grow: 1; border-bottom-width: 5px; border-top-width: 5px; border-left-width: 5px; border-right-width: 5px;">
                        <ui:Slider label="Brush size" value="10" high-value="100" name="brush_size" fill="false" low-value="10" style="width: auto; min-width: auto; flex-direction: column;">
                            <ui:VisualElement style="flex-grow: 1;"/>
                        </ui:Slider>
                        <ui:Slider label="Brush strength" value="0.1" high-value="0.3" name="brush_strength" fill="false" low-value="0.01" style="width: auto; min-width: auto; flex-direction: column;">
                            <ui:VisualElement style="flex-grow: 1;"/>
                        </ui:Slider>
                    </ui:VisualElement>
                    <ui:VisualElement name="add_subtract" style="flex-grow: 1; max-width: 150px; border-bottom-width: 5px; border-top-width: 5px; border-right-width: 5px; border-left-width: 5px;">
                        <ui:Button text="Add" name="add" style="min-width: 60px; max-width: 80px; min-height: 30px;"/>
                        <ui:Button text="Subtract" name="subtract" style="min-width: 60px; max-width: 80px; min-height: 30px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="colors" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; border-top-width: 5px;">
                        <ui:Button text="Red" name="red" style="height: auto; width: auto; background-color: rgb(226, 65, 65); -unity-text-align: middle-center; min-width: 60px; max-width: 80px; min-height: 30px;"/>
                        <ui:Button text="Blue" name="blue" style="height: auto; width: auto; background-color: rgb(65, 131, 226); min-width: 60px; max-width: 80px; min-height: 30px;"/>
                        <ui:Button text="Green" name="green" style="height: auto; width: auto; background-color: rgb(65, 226, 90); min-width: 60px; max-width: 80px; min-height: 30px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom" style="flex-grow: 1; border-top-width: 5px; border-bottom-width: 5px; flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; max-width: 800px; align-content: flex-start; min-width: auto; max-height: 50px; border-left-width: 4px;">
            <ui:Button text="Save mesh" name="save" style="min-height: 50px; max-height: 80px;"/>
            <ui:VisualElement name="info" style="flex-grow: 1; max-width: 200px; flex-direction: row; flex-wrap: nowrap; max-height: 30px; min-width: 100px;">
                <ui:Label text="Vertices : " name="vertices" style="border-left-width: 5px; border-right-width: 5px;"/>
                <ui:Label text="Faces : " name="faces" style="border-left-width: 5px; border-right-width: 5px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
